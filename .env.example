# ---- Google Gemini (free key: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CALL_DELAY=6

# ---- LangSmith tracing ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=job-matcher
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for the EU region

# ---- Site ----
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Email via Google Apps Script (see README). Leave empty = no emails are sent ----
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=

# ---- Daily matching ----
SCHEDULER_ENABLED=true
MATCH_HOUR=8
MATCH_MINUTE=0
TIMEZONE=Asia/Jerusalem
MATCH_MIN_SCORE=60
MATCH_BATCH_SIZE=40
